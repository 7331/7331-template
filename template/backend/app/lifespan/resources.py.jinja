from typing import TypedDict

from pydantic import BaseModel, ConfigDict

from app.infrastructure.postgres.client import Database
from app.infrastructure.rate_limit.limiter import InMemoryRateLimiter
{%- if include_redis %}
from app.infrastructure.redis.client import RedisClient
{%- endif %}
from app.shared.blocking_executor import BlockingExecutor


class Resources(BaseModel):
    model_config = ConfigDict(frozen=True, arbitrary_types_allowed=True)

    file_read_executor: BlockingExecutor
    database: Database
{%- if include_redis %}
    redis_client: RedisClient
{%- endif %}
    rate_limiter: InMemoryRateLimiter
    trusted_proxy_addresses: frozenset[str]


class ApiLifespanState(TypedDict):
    resources: Resources
